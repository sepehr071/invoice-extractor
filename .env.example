# PaddleX uses HuggingFace by default for model weights.
# Set this to skip the slow startup connectivity check:
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Override default model source ("huggingface" | "modelscope" | "bos"):
# PADDLE_PDX_MODEL_SOURCE=huggingface

# Cache location for downloaded models (default: ~/.paddlex/official_models/):
# PADDLE_PDX_CACHE_HOME=./.paddlex_cache

# ============================================================================
# LLM endpoint (extract.py). Cloud OpenRouter OR fully-local Ollama.
# ============================================================================
#
# Pick a provider profile with LLM_PROVIDER, then fill that profile's block.
# Resolution precedence (per field, highest first):
#   1. model passed to extract() in code
#   2. the LLM_PROVIDER profile's vars (below)
#   3. legacy flat vars (LLM_BASE_URL / EXTRACT_MODEL / ... — see bottom)
#   4. hard defaults
#
# LLM_PROVIDER: ollama | openrouter   (leave unset to use the legacy flat vars)
LLM_PROVIDER=ollama

# --- ollama profile (LOCAL / PRIVATE — recommended, no data leaves the box) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1   # default
# OLLAMA_API_KEY=ollama                       # any non-empty string; Ollama ignores it
# OLLAMA_MODEL=qwen3:32b                       # or whatever `ollama list` shows
# OLLAMA_STRUCTURED_MODE=json_object           # json_object (robust) | schema
# OLLAMA_DISABLE_THINKING=1                     # default true; auto-on for qwen3, keeps JSON clean/fast

# --- openrouter profile (CLOUD — sends OCR text to OpenRouter) ---
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default
# OPENROUTER_API_KEY=sk-or-v1-...                     # get one: https://openrouter.ai/settings/keys
# OPENROUTER_MODEL=openai/gpt-5-mini                  # default
# OPENROUTER_STRUCTURED_MODE=json_object              # json_object (default) | schema
# OPENROUTER_DISABLE_THINKING=0                        # default false

# --- legacy flat vars (FALLBACK when LLM_PROVIDER is unset) ---
# Still supported for back-compat; ignored once LLM_PROVIDER is set above.
# LLM_BASE_URL=http://localhost:11434/v1
# EXTRACT_MODEL=qwen3:32b
# OPENROUTER_API_KEY=ollama
# LLM_STRUCTURED_MODE=json_object
# LLM_DISABLE_THINKING=1

# ============================================================================
# Upload / parse limits (consumed by the API layer)
# ============================================================================
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=100
MAX_PAGE_MEGAPIXELS=40

# ============================================================================
# (ARCHIVED / dormant — sanctions removed from product) Sanctions screening env.
# Retained for reference only; not wired into the current pipeline.
# ============================================================================

# Sanctions LLM judge model (defaults to EXTRACT_MODEL when unset).
# SANCTIONS_MODEL=qwen3:32b

# Trade.gov Consolidated Screening List API key
# Get at https://api.trade.gov/signup/ — covers BIS Entity List, BIS DPL, BIS UVL, BIS MEU, State DDTC AECA Debarred, State Nonproliferation.
# If unset, CSL ingestion is skipped (only OFAC SDN + Consolidated will be screened).
CSL_API_KEY=

# --- UK + EU sanctions lists (enabled by default; downloaded via POST /api/sanctions/refresh) ---

# UK Sanctions List (FCDO). Open data, no key. Set to 0 to disable.
UK_SANCTIONS_ENABLED=1
# Override only if the FCDO moves the CSV (default is the published UKSL CSV):
# UK_SANCTIONS_CSV_URL=https://sanctionslist.fcdo.gov.uk/docs/UK-Sanctions-List.csv

# EU consolidated financial sanctions list (DG FISMA / FSF XML). Open data. Set to 0 to disable.
EU_FSF_ENABLED=1
# Override the full FSF URL if the EU rotates the public access token:
# EU_FSF_URL=https://webgate.ec.europa.eu/fsd/fsf/public/files/xmlFullSanctionsList_1_1/content?token=dG9rZW4tMjAxNw
