[Unit]
Description=invoice-ai (FastAPI + PaddleOCR + local Ollama extraction)
# Ensure the local model server is up first.
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
# --- EDIT THESE for your box ---
User=invoiceai
Group=invoiceai
WorkingDirectory=/opt/invoice-ai
EnvironmentFile=/opt/invoice-ai/.env
# uv-managed venv. Use the project's interpreter; no --reload in prod.
# Single worker: the job worker is a background thread + SQLite + one GPU.
ExecStart=/opt/invoice-ai/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
# Serves both the API and the built SPA (frontend/dist) on :8000.

[Install]
WantedBy=multi-user.target
